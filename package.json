{
  "name": "cmclient",
  "version": "2.0.0-rc.1",
  "license": "GPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "audit:policy": "node scripts/security-audit.mjs",
    "audit:dependencies:node": "pnpm audit --prod --audit-level high && pnpm audit --audit-level high && pnpm audit signatures",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @cmclient/contracts run build && pnpm --recursive --if-present run typecheck",
    "build": "node scripts/source-build.mjs javascript",
    "build:source:windows": "node scripts/source-build.mjs windows",
    "test": "pnpm --filter @cmclient/contracts run build && pnpm run test:workspace-tools && pnpm run test:fixtures && pnpm run test:legacy-removal && pnpm run test:security-audit && pnpm run test:release-artifacts && pnpm run test:supply-chain && pnpm run test:rc-readiness && pnpm run test:documentation && pnpm run test:p13-feasibility && pnpm run test:private-node && pnpm run test:systemd && pnpm run test:windows-service && pnpm run test:launchd && pnpm run test:docker && pnpm run test:load-contract && pnpm run test:source-build && pnpm run test:hardware-source-observer && vitest run",
    "test:workspace-tools": "bash ./scripts/test-workspace-tools.sh",
    "test:load": "node scripts/load-soak.mjs",
    "test:load-contract": "node --test scripts/load-soak.test.mjs",
    "test:hardware-source-observer": "node --test scripts/p18-hardware-source-observer.test.mjs",
    "test:source-build": "node --test scripts/source-build.test.mjs",
    "test:legacy-removal": "node --test scripts/legacy-removal-scan.test.mjs",
    "test:security-audit": "node --test scripts/security-audit.test.mjs",
    "test:release-artifacts": "node --test scripts/release-artifacts.test.mjs",
    "test:supply-chain": "node --test scripts/release-supply-chain.test.mjs",
    "test:rc-readiness": "node --test scripts/rc-readiness.test.mjs",
    "test:documentation": "node --test scripts/documentation-contract.test.mjs",
    "test:p13-feasibility": "node --test scripts/p13-feasibility-decision.test.mjs scripts/p13-gateway-bootstrap-lab.test.mjs scripts/p13-updater-driver-fixture.test.mjs scripts/p13-updater-artifact-evidence.test.mjs scripts/p13-updater-live-matrix.test.mjs scripts/p13-updater-windows-install-lab.test.mjs scripts/p13-nsis-path-hooks.test.mjs",
    "test:private-node": "node --test scripts/private-node-runtime.test.mjs",
    "rc:check": "node scripts/rc-readiness.mjs check-sources && node scripts/rc-readiness.mjs check-plan --input docs/testing/rc-field-validation-plan.json",
    "test:systemd": "node --test scripts/cmclient-systemd.test.mjs",
    "test:windows-service": "node --test scripts/cmclient-windows-service.test.mjs",
    "test:launchd": "node --test scripts/cmclient-launchd.test.mjs",
    "test:docker": "node --test scripts/container-runtime.test.mjs scripts/docker.test.mjs",
    "test:docker:smoke": "bash ./scripts/docker-smoke.sh",
    "test:e2e:web": "playwright test",
    "test:fixtures": "node --test test/fixtures/sanitized-packet-fixtures.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "22.20.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  }
}
