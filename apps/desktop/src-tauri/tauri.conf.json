{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CMClient",
  "version": "2.0.0-rc.1",
  "identifier": "io.cmclient.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CMClient",
        "width": 640,
        "height": 680,
        "minWidth": 420,
        "minHeight": 500,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
