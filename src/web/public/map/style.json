{
  "version": 8,
  "name": "TMAG Local Vector",
  "center": [120.5174, 23.66552],
  "zoom": 7,
  "glyphs": "/map/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "tiles": ["/map/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0b1220" }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "basemap",
      "source-layer": "ocean",
      "paint": { "fill-color": "#0b1220" }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "basemap",
      "source-layer": "land",
      "paint": {
        "fill-color": "#142233",
        "fill-outline-color": "#1f2f43"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#0a2436",
        "fill-outline-color": "#14364d"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "basemap",
      "source-layer": "water_lines",
      "paint": {
        "line-color": "#1c4c6a",
        "line-width": 1
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#30455a",
        "line-width": 1
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "basemap",
      "source-layer": "streets",
      "minzoom": 11,
      "paint": {
        "line-color": "#2a3b52",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 14, 1.6]
      }
    },
    {
      "id": "place-labels-major",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place_labels",
      "minzoom": 7,
      "filter": [
        "any",
        ["all", ["has", "population"], [">=", ["get", "population"], 50000]],
        ["in", ["get", "kind"], ["literal", ["country", "region", "province", "state", "city"]]]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name"],
          ["get", "name_en"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 12, 12, 18],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#e2edf8",
        "text-halo-color": "#0b1220",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels-medium",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place_labels",
      "minzoom": 10,
      "filter": [
        "any",
        ["all", ["has", "population"], [">=", ["get", "population"], 10000]],
        ["in", ["get", "kind"], ["literal", ["city", "town"]]]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name"],
          ["get", "name_en"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 11, 13, 14],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#c7d7ea",
        "text-halo-color": "#0b1220",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "boundary-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "boundary_labels",
      "minzoom": 9,
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name"],
          ["get", "name_en"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 12, 12],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#9fb2c9",
        "text-halo-color": "#0b1220",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "street_labels",
      "minzoom": 12,
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name"],
          ["get", "name_en"],
          ["get", "ref"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 14, 12],
        "symbol-placement": "line",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#b8c8dc",
        "text-halo-color": "#0b1220",
        "text-halo-width": 1
      }
    },
    {
      "id": "street-labels-points",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "street_labels_points",
      "minzoom": 13,
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name"],
          ["get", "name_en"],
          ["get", "ref"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 14, 12],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#b8c8dc",
        "text-halo-color": "#0b1220",
        "text-halo-width": 1
      }
    }
  ]
}
